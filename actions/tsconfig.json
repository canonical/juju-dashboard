{
  "compilerOptions": {
    "paths": {
      "@/lib": [
        "./src/lib/index.ts"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ]
    },
    "moduleResolution": "bundler",
    "strictNullChecks": true,
  },
  "include": [
    "./src",
    "./vite.config.ts"
  ],
  "references": [
    {
      "path": "../tsconfig.node.json"
    }
  ]
}
