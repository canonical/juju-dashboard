if [ -z "$PYTHONPATH" ]; then
    export PYTHONPATH="lib:src"
else
    export PYTHONPATH="lib:src:$PYTHONPATH"
fi

uv run flake8
uv run coverage run --branch --source=src -m unittest -v "$@"
uv run coverage report -m
